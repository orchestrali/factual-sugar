<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="https://sallyandbobminor.wordpress.com/wp-content/uploads/2025/10/linepencil.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Bellringing methods notebook">

    <title>Change Ringing Methods</title>

    <!-- import the webpage's stylesheet -->
    <link rel="stylesheet" href="/stylemethods.css" />
    
  </head>
  <body>
    <!-- header ???? -->
    <header>
      <div><h1>Method Notebook</h1></div>
      <div id="aboutbutton">About</div>
    </header>
    <h4>{{test}}</h4>
    
    <div id="alert" class="dialog">
      <p>You have unsaved changes! Abandon them?</p>
      <button id="abandon">Yes</button><button id="stayonpage">No, stay on this page</button>
    </div>
    <div id="deletedialog" class="dialog" style="display:none;">
      <p>Confirm delete <span></span>?</p>
      <button id="confirmdelete">Yes</button><button id="canceldelete" class="stayonpage">No</button>
    </div>
    <!-- about button? or dialog? where do I put the other? -->
    <div id="about" class="dialog" style="display:none;">
      <div class="closeabout"></div>
      <h3>About this site</h3>
      <h4>How it works</h4>
      <p>This is a website for exploring change-ringing methods. You can create collections, add methods to them, and make notes on both collections and methods.</p>
      <p class="test">This test version only saves collections and notes to your browser local storage, which won't transfer between devices and could accidentally be cleared at some point.</p>
      <h4>Background</h4>
      <p>The website is maintained by Alison Stevens. Links to Alison's other ringing sites can be found at <a href="https://www.changeringing.net" target="blank">www.changeringing.net</a>.</p>
      <h4>Planned additions/improvements</h4>
      <ul>
        <li>• Fancy method search</li>
        <li>• Option to show numbers when viewing method as lines</li>
        <li>• Download/print options</li>
        <li>• Premade collections to add</li>
        <li>• Choose additional table columns when viewing a collection</li>
        <li>• View a collection as list or method grids</li>
      </ul>
      <button class="closeabout">Close</button>
    </div>

    <div id="overlay"></div>
    <div id="loadingcontainer" class="dialog"></div>

    <div id="addmethodscreen" class="screen" style="display:none;">
      <div class="container">
        <button class="large viewcollections">My collections</button>
        <button class="large loadmethods">Load more methods</button>
      </div>
      <h3>Explore methods</h3>
      <div>
        <select id="methodclass">
          <option>Bob</option>
          <option>Place</option>
          <option>Treble Bob</option>
          <option>Delight</option>
          <option>Surprise</option>
          <option>Treble Place</option>
          <option>Alliance</option>
          <option>Hybrid</option>
          <option>Principle</option>
        </select>
        <select id="methodstage">
          <option value="3">3 - Singles</option>
          <option value="4">4 - Minimus</option>
          <option value="5">5 - Doubles</option>
          <option value="6">6 - Minor</option>
          <option value="7">7 - Triples</option>
          <option value="8">8 - Major</option>
          <option value="9">9 - Caters</option>
          <option value="10">10 - Royal</option>
          <option value="11">11 - Cinques</option>
          <option value="12">12 - Maximus</option>
          <option value="13">13 - Sextuples</option>
          <option value="14">14 - Fourteen</option>
          <option value="15">15 - Septuples</option>
          <option value="16">16 - Sixteen</option>
        </select>
      </div>
      <div>
        <label for="methodsearch">Search: <input type="text" id="methodsearch" /></label>
      </div>
      <div id="methodnamelist">
        <ul></ul>
      </div>
      <div id="methodbuttons">
        <button id="viewmethod">View</button>
        <button id="addmethod" class="addtocoll">Add to collection</button>
        <div id="addingdiv" class="hidden">
          <select id="colllist"></select>
          <button id="saveadd">Save</button>
        </div>
      </div>
    </div>

    <div id="collectionlist" class="screen">
      <div class="container">
        <button class="large" id="addmethods">Explore methods</button>
        <button class="large loadmethods">Load methods to explore</button>
      </div>
      <!-- this part needs to change for real version - login stuff -->
      <h3>My collections</h3>
      <table class="sortable">
        <thead><th>Collection</th><th>Methods</th></thead>
        <tbody>
          
        </tbody>
      </table>
      <button id="newcollection">Create new collection</button>
      <div id="newcollpanel" class="hidden">
        <div><button id="cancelnewcoll" class="cancel">Cancel</button></div>
        <label for="colltitle">Title: <input type="text" id="colltitle" /></label><button id="savecoll">Add</button>
        <p class="errors" id="newcollerror"><p>
      </div>
    </div>

    <div id="collectionpanel" class="screen" style="display:none;">
      <div class="container">
        <button class="large viewcollections">My collections</button>
      </div>
      <button id="editcollection">Edit collection</button>
      <span id="collsort">Sort by: <label><input type="radio" name="sort" value="title" />method title</label><label><input type="radio" name="sort" value="added" />date added</label></span>
      <button id="cancelcolledits" class="edit">Cancel</button>
      <button id="savecolledits" class="edit">Save changes</button>
      <h3></h3>
      <div id="edittitlepanel" class="edit">
        <label for="titleedit">New title: <input type="text" id="titleedit" /></label>
        <p class="errors" id="titleediterror"></p>
      </div>
      <table>
        <thead><th>Method title</th></thead>
        <tbody></tbody>
      </table>
    </div>

    <div id="methodpanel" class="screen" style="display:none;">
      <div class="container">
        <button class="large viewcollections">My collections</button>
      </div>
      <div id="methodbackcontainer"></div>
      <h3 id="methodtitle">
        
      </h3>
      <h4><div class="arrow"></div>Collections this method is in:</h4>
      <div id="methodcollections"></div>
      <div id="addtocollection">
        <label for="choosecoll">Add to collection: </label>
        <select id="choosecoll"></select>
        <button id="savemethod">Save</button>
      </div>
      <h4><div class="arrow"></div>Display options</h4>
      <div id="displayoptions">
        
        <fieldset id="displayopts">
          <ul>
          
            <li><label for="grid"><input type="radio" id="grid" name="display" value="grid" checked />Grid</label></li>
            <li><label for="lines"><input type="radio" id="lines" name="display" value="lines" />Line(s)</label></li>
          </ul>
        </fieldset>
        <ul id="lineopts">
          <li class="lineopt">
            <select id="bluebell"></select>
          </li>
          <!--<li class="lineopt"></li>
          <li class="lineopt"></li>-->
        </ul>
      </div>
      <h4><div class="arrow"></div>Method info</h4>
      <div id="methodinfobox"></div>
      <div id="methodcontainer"></div>
    </div>

    <div id="notepanel">
      <div id="noteslist" class="notescreen">
        <button id="addnote" class="change">Add note</button>
        <ul></ul>
      </div>
      <div id="noteeditor" class="notescreen">
        <div>
          <label for="notetitle">Title: <input type="text" id="notetitle" /></label>
        </div>
        <p class="errors" id="notetitleerror"></p>
        <textarea id="note" rows="20" cols="30"></textarea>
        <div>
          <button id="savenote">Save</button>
          <button id="cancelnote">Cancel</button>
        </div>
        
      </div>
      <div id="noteviewer" class="notescreen">
        <button id="noteback">Back to list</button>
        <button id="editnote" class="change">Edit note</button>
        <!--<button id="deletenote" class="change">Delete note</button>-->
        <h4></h4>
        
      </div>
    </div>

    
    
    <script
  src="https://code.jquery.com/jquery-3.6.0.min.js"
  integrity="sha256-/xUj+3OJU5yExlq6GSYGSHk7tPXikynS7ogEvDej/m4="
  crossorigin="anonymous"></script>
    <script src="jquery.svg.js"></script>
    <script src="jquery.svgdom.js"></script>
    <script src="/scriptmethods.js"></script>
  </body>
</html>
